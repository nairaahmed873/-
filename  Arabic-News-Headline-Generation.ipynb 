        "@torch.no_grad()\n",
        "def generate_headlines(encoder_array, max_len=MAX_TITLE_LEN, suppress_unk=True, chunk_size=128):\n",
        "    \"\"\"Greedy word-by-word generation until <EOS> or max_len. Returns a list of ID lists.\"\"\"\n",
        "    model.eval()\n",
        "    all_outputs = []\n",
        "\n",
        "    for start in range(0, len(encoder_array), chunk_size):\n",
        "        batch = to_tensor(encoder_array[start:start + chunk_size]).to(device)\n",
        "        n = batch.size(0)\n",
        "\n",
        "        hidden = model.encoder(batch)                                   # article -> state\n",
        "        token = torch.full((n, 1), SOS_ID, dtype=torch.long, device=device)  # start with <SOS>\n",
        "        generated = [[] for _ in range(n)]\n",
        "        finished = [False] * n\n",
        "\n",
        "        for _ in range(max_len):\n",
        "            logits, hidden = model.decoder(token, hidden)\n",
        "            probs = torch.softmax(logits[:, -1, :], dim=-1)             # probabilities over the vocabulary\n",
        "\n",
        "            # Never generate PAD / SOS (and optionally UNK)\n",
        "            probs[:, PAD_ID] = 0.0\n",
        "            probs[:, SOS_ID] = 0.0\n",
        "            if suppress_unk:\n",
        "                probs[:, UNK_ID] = 0.0\n",
        "\n",
        "            next_token = probs.argmax(dim=-1)                           # greedy choice\n",
        "\n",
        "            for k, t in enumerate(next_token.tolist()):\n",
        "                if finished[k]:\n",
        "                    continue\n",
        "                if t == EOS_ID:\n",
        "                    finished[k] = True                                  # stop at <EOS>\n",
        "                else:\n",
        "                    generated[k].append(t)\n",
        "\n",
        "            if all(finished):\n",
        "                break\n",
        "\n",
        "            token = next_token.unsqueeze(1)                             # feed the prediction back in\n",
        "\n",
        "        all_outputs.extend(generated)\n",
        "\n",
        "    return all_outputs\n",
        "\n",
        "\n",
        "def ids_to_text(ids):\n",
        "    return \" \".join(idx2word[i] for i in ids)\n",
        "\n",
        "\n",
        "def article_to_encoder_input(raw_article):\n",
        "    \"\"\"Same preprocessing as training: clean -> tokenize -> IDs -> EOS -> pad.\"\"\"\n",
        "    tokens = preprocess_arabic(raw_article).split()\n",
        "    ids = [word2idx.get(t, UNK_ID) for t in tokens[:MAX_ARTICLE_LEN - 1]] + [EOS_ID]\n",
        "    ids += [PAD_ID] * (MAX_ARTICLE_LEN - len(ids))\n",
        "    return np.array(ids, dtype=np.int64)\n",
        "\n",
        "\n",
        "def generate_headline_from_text(raw_article, **kwargs):\n",
        "    \"\"\"Generate a headline for one new (raw) Arabic article.\"\"\"\n",
        "    encoder_input = article_to_encoder_input(raw_article).reshape(1, -1)\n",
        "    return ids_to_text(generate_headlines(encoder_input, **kwargs)[0])\n",
        "\n",
        "\n",
        "print(\"Inference functions are ready!\")"
      ]
