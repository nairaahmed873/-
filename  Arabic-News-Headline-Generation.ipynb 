        "class LSTMEncoder(nn.Module):\n",
        "    def __init__(self, vocab_size, embed_dim, hidden_dim):\n",
        "        super().__init__()\n",
        "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=PAD_ID)\n",
        "        self.lstm = nn.LSTM(embed_dim, hidden_dim, batch_first=True)\n",
        "\n",
        "    def forward(self, src):\n",
        "        lengths = (src != PAD_ID).sum(dim=1)\n",
        "        packed = pack_padded_sequence(\n",
        "            self.embedding(src), lengths.cpu(), batch_first=True, enforce_sorted=False\n",
        "        )\n",
        "        _, (h_n, c_n) = self.lstm(packed)\n",
        "        return h_n, c_n                      # Hidden State و Cell State\n",
        "\n",
        "\n",
        "class LSTMDecoder(nn.Module):\n",
        "    def __init__(self, vocab_size, embed_dim, hidden_dim, dropout):\n",
        "        super().__init__()\n",
        "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=PAD_ID)\n",
        "        self.lstm = nn.LSTM(embed_dim, hidden_dim, batch_first=True)\n",
        "        self.dropout = nn.Dropout(dropout)\n",
        "        self.fc = nn.Linear(hidden_dim, vocab_size)\n",
        "\n",
        "    def forward(self, tokens, state):\n",
        "        output, state = self.lstm(self.embedding(tokens), state)   # state = (h, c)\n",
        "        logits = self.fc(self.dropout(output))\n",
        "        return logits, state\n",
        "\n",
        "\n",
        "class Seq2SeqLSTM(nn.Module):\n",
        "    def __init__(self, vocab_size, embed_dim, hidden_dim, dropout):\n",
        "        super().__init__()\n",
        "        self.encoder = LSTMEncoder(vocab_size, embed_dim, hidden_dim)\n",
        "        self.decoder = LSTMDecoder(vocab_size, embed_dim, hidden_dim, dropout)\n",
        "\n",
        "    def forward(self, src, decoder_input):\n",
        "        state = self.encoder(src)\n",
        "        logits, _ = self.decoder(decoder_input, state)\n",
        "        return logits\n",
        "\n",
        "\n",
        "torch.manual_seed(SEED)\n",
        "torch.cuda.manual_seed_all(SEED)\n",
        "\n",
        "lstm_model = Seq2SeqLSTM(vocab_size, EMBED_DIM, HIDDEN_DIM, DROPOUT).to(device)\n",
        "lstm_params = sum(p.numel() for p in lstm_model.parameters() if p.requires_grad)\n",
        "\n",
