        "lstm_criterion = nn.CrossEntropyLoss(ignore_index=PAD_ID, reduction=\"sum\")\n",
        "lstm_optimizer = torch.optim.Adam(lstm_model.parameters(), lr=LEARNING_RATE)\n",
        "\n",
        "lstm_train_loader = DataLoader(\n",
        "    train_dataset, batch_size=BATCH_SIZE, shuffle=True,\n",
        "    generator=torch.Generator().manual_seed(SEED)\n",
        ")\n",
        "\n",
        "\n",
        "def run_epoch_generic(net, loader, train, optimizer, criterion):\n",
        "    net.train(train)\n",
        "    total_loss, total_tokens = 0.0, 0\n",
        "\n",
        "    for src, decoder_input, decoder_target in loader:\n",
        "        src, decoder_input, decoder_target = (\n",
        "            src.to(device), decoder_input.to(device), decoder_target.to(device)\n",
        "        )\n",
        "        n_tokens = (decoder_target != PAD_ID).sum().item()\n",
        "\n",
        "        with torch.set_grad_enabled(train):\n",
        "            logits = net(src, decoder_input)\n",
        "            loss_sum = criterion(logits.reshape(-1, logits.size(-1)), decoder_target.reshape(-1))\n",
        "\n",
        "        if train:\n",
        "            optimizer.zero_grad()\n",
        "            (loss_sum / n_tokens).backward()\n",
        "            nn.utils.clip_grad_norm_(net.parameters(), CLIP_NORM)\n",
        "            optimizer.step()\n",
        "\n",
        "        total_loss += loss_sum.item()\n",
        "        total_tokens += n_tokens\n",
        "\n",
        "    return total_loss / total_tokens"
