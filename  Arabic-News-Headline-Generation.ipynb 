        "@torch.no_grad()\n",
        "def generate_headlines_with(net, encoder_array, max_len=MAX_TITLE_LEN, suppress_unk=True, chunk_size=128):\n",
        "    net.eval()\n",
        "    all_outputs = []\n",
        "\n",
        "    for start in range(0, len(encoder_array), chunk_size):\n",
        "        batch = to_tensor(encoder_array[start:start + chunk_size]).to(device)\n",
        "        n = batch.size(0)\n",
        "\n",
        "        state = net.encoder(batch)          # h للـ RNN أو (h, c) للـ LSTM\n",
        "        token = torch.full((n, 1), SOS_ID, dtype=torch.long, device=device)\n",
        "        generated = [[] for _ in range(n)]\n",
        "        finished = [False] * n\n",
        "\n",
        "        for _ in range(max_len):\n",
        "            logits, state = net.decoder(token, state)\n",
        "            probs = torch.softmax(logits[:, -1, :], dim=-1)\n",
        "\n",
        "            probs[:, PAD_ID] = 0.0\n",
        "            probs[:, SOS_ID] = 0.0\n",
        "            if suppress_unk:\n",
