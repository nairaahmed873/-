        "class Encoder(nn.Module):\n",
        "    def __init__(self, vocab_size, embed_dim, hidden_dim):\n",
        "        super().__init__()\n",
        "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=PAD_ID)\n",
        "        self.rnn = nn.RNN(embed_dim, hidden_dim, batch_first=True)\n",
        "\n",
        "    def forward(self, src):\n",
        "        lengths = (src != PAD_ID).sum(dim=1)                 # real length of each article\n",
        "        packed = pack_padded_sequence(\n",
        "            self.embedding(src), lengths.cpu(), batch_first=True, enforce_sorted=False\n",
        "        )\n",
        "        _, h_n = self.rnn(packed)                            # h_n shape: (1, batch, hidden)\n",
        "        return h_n\n",
        "\n",
        "\n",
        "class Decoder(nn.Module):\n",
        "    def __init__(self, vocab_size, embed_dim, hidden_dim, dropout):\n",
        "        super().__init__()\n",
        "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=PAD_ID)\n",
        "        self.rnn = nn.RNN(embed_dim, hidden_dim, batch_first=True)\n",
        "        self.dropout = nn.Dropout(dropout)\n",
        "        self.fc = nn.Linear(hidden_dim, vocab_size)          # scores for every word\n",
        "\n",
        "    def forward(self, tokens, hidden):\n",
        "        output, hidden = self.rnn(self.embedding(tokens), hidden)\n",
        "        logits = self.fc(self.dropout(output))               # (batch, steps, vocab)\n",
        "        return logits, hidden\n",
        "\n",
        "\n",
        "class Seq2SeqRNN(nn.Module):\n",
        "    def __init__(self, vocab_size, embed_dim, hidden_dim, dropout):\n",
        "        super().__init__()\n",
        "        self.encoder = Encoder(vocab_size, embed_dim, hidden_dim)\n",
        "        self.decoder = Decoder(vocab_size, embed_dim, hidden_dim, dropout)\n",
        "\n",
        "    def forward(self, src, decoder_input):\n",
        "        hidden = self.encoder(src)                            # encoder state ...\n",
        "        logits, _ = self.decoder(decoder_input, hidden)       # ... becomes the decoder's initial state\n",
        "        return logits\n",
        "\n",
        "\n",
        "model = Seq2SeqRNN(vocab_size, EMBED_DIM, HIDDEN_DIM, DROPOUT).to(device)\n",
        "print(model)\n",
