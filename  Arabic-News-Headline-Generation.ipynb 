        "import math\n",
        "\n",
        "def bleu1_corpus(refs, hyps):\n",
        "    clipped, hyp_total, ref_total = 0, 0, 0\n",
        "    for ref, hyp in zip(refs, hyps):\n",
        "        ref_tokens, hyp_tokens = ref.split(), hyp.split()\n",
        "        ref_counts = Counter(ref_tokens)\n",
        "        for word, count in Counter(hyp_tokens).items():\n",
        "            clipped += min(count, ref_counts.get(word, 0))\n",
        "        hyp_total += len(hyp_tokens)\n",
        "        ref_total += len(ref_tokens)\n",
        "\n",
        "    if hyp_total == 0:\n",
        "        return 0.0\n",
        "    precision = clipped / hyp_total\n",
        "    brevity_penalty = 1.0 if hyp_total > ref_total else math.exp(1 - ref_total / hyp_total)\n",
        "    return brevity_penalty * precision\n",
        "\n",
        "\n",
        "def lcs_length(a, b):\n",
        "    prev = [0] * (len(b) + 1)\n",
        "    for x in a:\n",
        "        curr = [0]\n",
        "        for j, y in enumerate(b, 1):\n",
        "            curr.append(prev[j - 1] + 1 if x == y else max(prev[j], curr[j - 1]))\n",
        "        prev = curr\n",
        "    return prev[-1]\n",
        "\n",
        "\n",
        "def rouge_l_f1(ref, hyp):\n",
        "    ref_tokens, hyp_tokens = ref.split(), hyp.split()\n",
        "    if not ref_tokens or not hyp_tokens:\n",
        "        return 0.0\n",
        "    lcs = lcs_length(ref_tokens, hyp_tokens)\n",
        "    if lcs == 0:\n",
        "        return 0.0\n",
        "    precision, recall = lcs / len(hyp_tokens), lcs / len(ref_tokens)\n",
        "    return 2 * precision * recall / (precision + recall)\n",
        "\n",
        "\n",
        "def rouge_l_corpus(refs, hyps):\n",
        "    return float(np.mean([rouge_l_f1(r, h) for r, h in zip(refs, hyps)]))"
      ],
